# Optional AI Memory server settings. Keep secrets in the local env file at
# ~/.config/ai-memory/env; never commit that file.
#
# The local loopback deployment does not require authentication or an LLM.
# Uncomment and fill only the settings you intentionally enable.
# AI_MEMORY_AUTH_TOKEN=
# AI_MEMORY_LLM_PROVIDER=
# AI_MEMORY_LLM_MODEL=
# AI_MEMORY_LLM_BASE_URL=
# ANTHROPIC_API_KEY=
# OPENAI_API_KEY=
# AI_MEMORY_EMBEDDING_PROVIDER=
# AI_MEMORY_EMBEDDING_MODEL=
